local function attachCharacter(humanoid,root)
    removePhysics()
    if not root or not root.Parent or not humanoid or humanoid.Health<=0 then return end

    local attachment=Instance.new("Attachment")
    attachment.Name="ReyznCharacterFly_Attachment"
    attachment.Parent=root

    local linear=Instance.new("LinearVelocity")
    linear.Name="ReyznCharacterFly_Velocity"
    linear.Attachment0=attachment
    linear.RelativeTo=Enum.ActuatorRelativeTo.World
    linear.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector
    pcall(function()linear.ForceLimitsEnabled=false end)
    linear.MaxForce=math.huge
    linear.VectorVelocity=Vector3.zero
    linear.Parent=root

    local orientation=Instance.new("AlignOrientation")
    orientation.Name="ReyznCharacterFly_Orientation"
    orientation.Mode=Enum.OrientationAlignmentMode.OneAttachment
    orientation.Attachment0=attachment
    orientation.MaxTorque=math.huge
    orientation.Responsiveness=16
    orientation.RigidityEnabled=false
    orientation.CFrame=root.CFrame.Rotation
    orientation.Parent=root

    armed.mode="character"
    armed.root=root
    armed.humanoid=humanoid
    armed.originalAutoRotate=humanoid.AutoRotate
    armed.attachment,armed.velocity,armed.orientation=attachment,linear,orientation
    humanoid.AutoRotate=false
    -- Freefall preserves the native thumbstick/keyboard inputs and allows
    -- touching seats, unlike PlatformStand which can block seating.
    if not humanoid.Sit then
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
    end
    if UI.pad then UI.pad.Visible=Input.TouchEnabled end
    state.burst=1
end

local function walkingCharacter()
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    local root=character and character:FindFirstChild("HumanoidRootPart")
    if humanoid and humanoid.Health>0 and root and root:IsA("BasePart")
        and not root.Anchored and not humanoid.SeatPart then
        return humanoid,root
    end
    return nil,nil
end

