local function removePhysics()
    local oldVelocity,oldOrientation,oldAttachment=armed.velocity,armed.orientation,armed.attachment
    local oldHumanoid,oldAutoRotate=armed.humanoid,armed.originalAutoRotate
    armed.mode,armed.seat,armed.root,armed.humanoid,armed.originalAutoRotate=nil,nil,nil,nil,nil
    armed.attachment,armed.velocity,armed.orientation=nil,nil,nil
    if oldVelocity then oldVelocity:Destroy() end
    if oldOrientation then oldOrientation:Destroy() end
    if oldAttachment then oldAttachment:Destroy() end
    -- Restore normal character rotation when flight ends or transfers to a vehicle.
    if oldHumanoid and oldHumanoid.Parent and oldAutoRotate~=nil then
        oldHumanoid.AutoRotate=oldAutoRotate
    end
    table.clear(heldTouch)
    if UI.pad then UI.pad.Visible=false end
end

local function seatedVehicle()
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    local seat=humanoid and humanoid.SeatPart
    if not seat or not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) or seat.Occupant~=humanoid then
        return nil,nil
    end
    local root=seat.AssemblyRootPart or seat
    if not seat:IsDescendantOf(workspace) or not root or root.Anchored or seat.Anchored then
        return nil,nil
    end
    return seat,root
end

