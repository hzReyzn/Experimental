local base="https://raw.githubusercontent.com/hzReyzn/Ghislain/main/assets/reyzn-x/"
local specs={
    {"background-cyber-v2.jpg","jpg",artworkImages.Background},
    {"icon-home-v1.png","png",artworkImages.IconHome},
    {"icon-visuals-v1.png","png",artworkImages.IconVisuals},
    {"icon-settings-v1.png","png",artworkImages.IconSettings},
    {"launcher-r-v1.png","png",{UI.logo}},
    {"flame-wisp-v1.png","png",VFX.images},
}
for _,spec in ipairs(specs)do
    spawn(function()
        local custom=getcustomasset or getsynasset
        if type(custom)~="function" or type(writefile)~="function" then return end
        local file="ReyznVehicleFly_"..spec[1]
        local uri
        local okCached,isCached=pcall(function()return type(isfile)=="function" and isfile(file)end)
        if okCached and isCached then
            local worked,url=pcall(custom,file)
            if worked then uri=url end
        end
        if not uri then
            local ok,data=pcall(function()return game:HttpGet(base..spec[1])end)
            if not state.alive then return end
            if ok and type(data)=="string" and #data>1000 then
                local valid=(spec[2]=="jpg" and data:sub(1,3)=="\255\216\255")
                    or (spec[2]=="png" and data:sub(1,8)=="\137PNG\13\10\26\10")
                if valid and pcall(writefile,file,data) then
                    local worked,url=pcall(custom,file)
                    if worked then uri=url end
                end
            end
        end
        if state.alive and type(uri)=="string" then
            for _,sprite in ipairs(spec[3])do sprite.Image=uri end
        end
    end)
end
