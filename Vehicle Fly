local function beginDrag(target,input)
    local kind=input.UserInputType
    if dragged or (kind~=Enum.UserInputType.MouseButton1 and kind~=Enum.UserInputType.Touch) then return end
    dragged={target=target,input=input,start=input.Position,pos=target.Position,touch=kind==Enum.UserInputType.Touch,moved=false}
end
connect(UI.dragArea.InputBegan,function(input)beginDrag(UI.window,input)end)
connect(UI.panelDrag.InputBegan,function(input)beginDrag(UI.window,input)end)
connect(UI.launcher.InputBegan,function(input)beginDrag(UI.launcher,input)end)
connect(Input.InputChanged,function(input)
    if not dragged or (dragged.touch and input~=dragged.input) then return end
    if not dragged.touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local delta=input.Position-dragged.start
    if not dragged.moved and delta.Magnitude<5 then return end
    dragged.moved=true
    local p=dragged.pos
    dragged.target.Position=UDim2.new(p.X.Scale,p.X.Offset+delta.X,p.Y.Scale,p.Y.Offset+delta.Y)
end)
connect(Input.InputEnded,function(input)
    if not dragged or (dragged.touch and input~=dragged.input) then return end
    if not dragged.touch and input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    if dragged.target==UI.launcher and dragged.moved then state.suppressLauncherUntil=os.clock()+.5 end
    dragged=nil
end)
connect(Input.WindowFocusReleased,function()dragged=nil end)
connect(Input.InputBegan,function(input,processed)
    if not processed and input.KeyCode==Enum.KeyCode.RightShift then setMinimized(not minimized) end
end)
local function shutdown()
    if not state.alive then return end
    stop()
    state.alive=false
    for _,c in ipairs(connections)do c:Disconnect()end
    for _,c in ipairs(extras)do c:Disconnect()end
    for _,t in pairs(tweens)do t:Cancel()end
    for thread in pairs(threads)do if coroutine.status(thread)~="dead" then pcall(task.cancel,thread)end end
end
addConnection(UI.gui.Destroying,shutdown)

