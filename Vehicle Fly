-- Drag only the title surface, so buttons always receive taps.
local function beginDrag(target,input)
    if dragging or (input.UserInputType~=Enum.UserInputType.Touch
      and input.UserInputType~=Enum.UserInputType.MouseButton1) then return end
    dragging={target=target,input=input,origin=input.Position,pos=target.Position,
      touch=input.UserInputType==Enum.UserInputType.Touch,moved=false}
end
connect(UI.dragBar.InputBegan,function(input)beginDrag(UI.window,input)end)
connect(UI.launcher.InputBegan,function(input)beginDrag(UI.launcher,input)end)
connect(Input.InputChanged,function(input)
    if not dragging then return end
    if dragging.touch and input~=dragging.input then return end
    if not dragging.touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local delta=input.Position-dragging.origin
    if delta.Magnitude<5 and not dragging.moved then return end
    dragging.moved=true
    local p=dragging.pos
    dragging.target.Position=UDim2.new(p.X.Scale,p.X.Offset+delta.X,p.Y.Scale,p.Y.Offset+delta.Y)
end)
connect(Input.InputEnded,function(input)
    if not dragging then return end
    if dragging.touch and input~=dragging.input then return end
    if not dragging.touch and input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    if dragging.moved and dragging.target==UI.launcher then state.launcherMoved=os.clock()+.35 end
    dragging=nil
end)
connect(Input.WindowFocusReleased,function()dragging=nil end)

local function cleanup()
    if not state.alive then return end
    state.alive=false
    features.fly.enabled=false
    removePhysics()
    for _,con in ipairs(connections)do pcall(function()con:Disconnect()end)end
    for _,t in pairs(tweens)do pcall(function()t:Cancel()end)end
end
