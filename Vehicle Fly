connect(RunService.Heartbeat,function(dt)
    if not features.fly.enabled then return end
    local seat,root=getSeat()
    if seat~=session.seat or root~=session.root or not session.linear or not session.linear.Parent
       or not session.attachment or not session.attachment.Parent then
        UI.flightToggle:setEnabled(false)
        UI.status.Text="FLIGHT STOPPED | EXITED VEHICLE"
        return
    end
    local camera=workspace.CurrentCamera
    local f=(camera and camera.CFrame.LookVector) or root.CFrame.LookVector
    local r=(camera and camera.CFrame.RightVector) or root.CFrame.RightVector
    local front=Vector3.new(f.X,0,f.Z)
    local right=Vector3.new(r.X,0,r.Z)
    if front.Magnitude<.01 then
        local original=root.CFrame.LookVector
        front=Vector3.new(original.X,0,original.Z)
    end
    if front.Magnitude<.01 then front=Vector3.new(0,0,-1) end
    front=front.Unit
    if right.Magnitude<.01 then right=Vector3.new(-front.Z,0,front.X) end
    right=right.Unit
    local forward=(pressed("forward") and 1 or 0)-(pressed("back") and 1 or 0)
    local sideways=(pressed("right") and 1 or 0)-(pressed("left") and 1 or 0)
    local up=(pressed("up") and 1 or 0)-(pressed("down") and 1 or 0)
    local desired=front*forward+right*sideways+Vector3.new(0,up,0)
    if desired.Magnitude>1 then desired=desired.Unit end
    session.linear.VectorVelocity=desired*speed
    if session.orient then
        session.orient.Enabled=features.level.enabled
        if features.level.enabled then
            local target=front
            if not features.camera.enabled then
                local facing=root.CFrame.LookVector
                local flat=Vector3.new(facing.X,0,facing.Z)
                if flat.Magnitude>.01 then target=flat.Unit end
            end
            session.orient.CFrame=CFrame.lookAt(Vector3.zero,target,Vector3.yAxis)
        end
    end
end)

