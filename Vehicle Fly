-- Dedicated keyboard fallback for WASD, and E/Q for altitude.
local keys={
    [Enum.KeyCode.W]="forward",[Enum.KeyCode.Up]="forward",
    [Enum.KeyCode.S]="back",[Enum.KeyCode.Down]="back",
    [Enum.KeyCode.A]="left",[Enum.KeyCode.Left]="left",
    [Enum.KeyCode.D]="right",[Enum.KeyCode.Right]="right",
    [Enum.KeyCode.E]="up",[Enum.KeyCode.Q]="down"
}
connect(Input.InputBegan,function(input,processed)
    if processed or Input:GetFocusedTextBox() then return end
    if input.UserInputType==Enum.UserInputType.Keyboard then
        local direction=keys[input.KeyCode]
        if direction then heldKeys[input.KeyCode]=direction end
    end
end)
connect(Input.InputEnded,function(input)
    if input.UserInputType==Enum.UserInputType.Keyboard then heldKeys[input.KeyCode]=nil end
end)
connect(Input.WindowFocusReleased,function()
    table.clear(heldKeys)
    table.clear(heldTouch)
end)
local function keyHeld(action)
    if heldTouch[action] then return true end
    for _,v in pairs(heldKeys)do
        if v==action then return true end
    end
    return false
end

local function horizontalInput()
    -- Roblox PlayerModule is shared by joystick and keyboard.
    if activeMoveControls then
        local ok,m=pcall(function()return activeMoveControls:GetMoveVector()end)
        if ok and typeof(m)=="Vector3" then
            local x,z=math.clamp(m.X,-1,1),math.clamp(m.Z,-1,1)
            if x*x+z*z>.005 then return x,-z end
        end
    end
    -- Keyboard fallback if the controls module is unavailable.
    local x=(keyHeld("right") and 1 or 0)-(keyHeld("left") and 1 or 0)
    local f=(keyHeld("forward") and 1 or 0)-(keyHeld("back") and 1 or 0)
    if x~=0 or f~=0 then return x,f end
    -- Humanoid movement is a backup for custom mobile thumbsticks.
    local char=player.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.MoveDirection.Magnitude>.05 then
        local cam=workspace.CurrentCamera
        if cam then
            local right=cam.CFrame.RightVector
            local forward=cam.CFrame.LookVector
            return hum.MoveDirection:Dot(right),hum.MoveDirection:Dot(Vector3.new(forward.X,0,forward.Z).Unit)
        end
    end
    return 0,0
end

connect(RunService.Heartbeat,function()
    if not features.fly.enabled then
        if armed.root then removePhysics() end
        return
    end

    -- Vehicle wins while seated; otherwise fly the player.
    local seat,vehicleRoot=seatedVehicle()
    local targetMode,targetRoot,targetHumanoid
    if seat then
        targetMode,targetRoot="vehicle",vehicleRoot
    else
        targetHumanoid,targetRoot=walkingCharacter()
        if targetHumanoid then
            targetMode="character"
        end
    end

    if not targetRoot then
        if armed.root then removePhysics() end
        return -- ON stays selected across sitting, leaving and respawning
    end

    if armed.mode~=targetMode or armed.root~=targetRoot
        or (targetMode=="vehicle" and armed.seat~=seat)
        or (targetMode=="character" and armed.humanoid~=targetHumanoid)
        or not armed.velocity or not armed.velocity.Parent then
        if targetMode=="vehicle" then
            attachVehicle(seat,targetRoot)
        else
            attachCharacter(targetHumanoid,targetRoot)
        end
    end
    if not armed.velocity then return end

    local camera=workspace.CurrentCamera
    local cameraLook=camera and camera.CFrame.LookVector or targetRoot.CFrame.LookVector
    local cameraRight=camera and camera.CFrame.RightVector or targetRoot.CFrame.RightVector
    local look=flightDirection.lockDirection and flightDirection.lockedLook or cameraLook
    local right=flightDirection.lockDirection and flightDirection.lockedRight or cameraRight
    look=look or cameraLook
    right=right or cameraRight

    -- Rotate all steering axes around the world Y axis in 45° increments.
    local rotation=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(flightDirection.yawOffset))
    look=rotation:VectorToWorldSpace(look)
    right=rotation:VectorToWorldSpace(right)
    local flatLook=Vector3.new(look.X,0,look.Z)
    if flatLook.Magnitude<.001 then
        flatLook=Vector3.new(targetRoot.CFrame.LookVector.X,0,targetRoot.CFrame.LookVector.Z)
    end
    if flatLook.Magnitude<.001 then flatLook=Vector3.new(0,0,-1) end
    flatLook=flatLook.Unit

    -- Look Up/Down ON includes camera pitch when flying forward.
    local forward=flightDirection.lookUpDown and look.Unit or flatLook
    local side=Vector3.new(right.X,0,right.Z)
    if side.Magnitude<.001 then side=Vector3.new(-flatLook.Z,0,flatLook.X) end
    side=side.Unit

    local x,z=horizontalInput()
    local altitude=(keyHeld("up") and 1 or 0)-(keyHeld("down") and 1 or 0)
    local direction=side*x+forward*z+Vector3.new(0,altitude,0)
    if direction.Magnitude>1 then direction=direction.Unit end
    armed.velocity.VectorVelocity=direction*speed
    if armed.orientation then
        armed.orientation.CFrame=CFrame.lookAt(Vector3.zero,flatLook,Vector3.yAxis)
    end
end)

