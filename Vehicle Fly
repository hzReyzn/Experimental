local lastStatus=0
local phase,budget=0,0
connect(RunService.RenderStepped,function(dt)
    budget+=dt
    if budget<1/60 then return end
    local delta=budget;budget=budget%(1/60)
    phase+=delta
    state.phase=phase
    state.burst=math.max(0,(state.burst or 0)-delta*2.6)
    VFX.reflections:update(delta)
    if UI.launcher.Visible then UI.launcherAura:update(phase,state.burst)end
    if UI.window.Visible then
        UI.dockAura:update(phase,state.burst)
        if not collapsed then UI.panelAura:update(phase+.63,state.burst)end
        for i,fx in ipairs({UI.dockFx,UI.panelFx})do
            if i==1 or not collapsed then
                fx.inward:update(phase,state.burst)
                fx.neon:update(phase,.10+.02*math.sin(phase*.6)^2)
                fx.beamGradient.Offset=Vector2.new(math.sin(phase*.2+i)*.3,0)
            end
        end
        for _,record in ipairs(buttons)do
            record.neon:update(phase,.085+record.selection.Value*.11+record.energy.Value*.04)
            record.selectedGradient.Offset=record.neon.wash.Offset
        end
        if currentTab=="Home" and not collapsed then UI.heroNeon:update(phase,.08)end
        if currentTab=="Flight" and not collapsed then UI.flightToggle:update(phase)end
        if currentTab=="Settings" and not collapsed then
            UI.cameraToggle:update(phase);UI.levelToggle:update(phase)
        end
    end
    UI.logoFallback.Visible=UI.logo.Image=="" or not UI.logo.IsLoaded
    for _,sprite in ipairs(iconSprites)do
        local loaded=sprite.image.Image~="" and sprite.image.IsLoaded
        for _,line in ipairs(sprite.fallback)do line.Visible=not loaded end
    end
    if phase-lastStatus>.4 then
        lastStatus=phase
        local seat=getSeat()
        if not features.fly.enabled then
            UI.heroStatus.Text=seat and "VEHICLE FLY\nStatus: Ready to fly" or "VEHICLE FLY\nStatus: Waiting for vehicle"
            if seat and UI.status.Text=="SIT IN A VEHICLE FIRST" then UI.status.Text="READY | TAP VEHICLE FLY" end
        else
            UI.heroStatus.Text="VEHICLE FLY\nStatus: Flying at "..speed.." studs/s"
        end
    end
end)
return UI.gui
