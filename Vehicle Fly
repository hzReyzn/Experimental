}
for _,spec in ipairs(assets)do
    spawn(function()
        local custom=getcustomasset or getsynasset
        if type(custom)~="function" or type(writefile)~="function" then return end
        local filename="ReyznVehicleFly_"..spec[1]
        local url
        if type(isfile)=="function" and isfile(filename) then
            local ok,result=pcall(custom,filename)
            if ok and type(result)=="string" then url=result end
        end
        if not url then
            local ok,data=pcall(function()return game:HttpGet(spec[4] or assetRoot..spec[1])end)
            if not state.alive then return end
            if ok and type(data)=="string" and #data>1000 then
                local valid=(spec[2]=="jpg" and data:sub(1,3)=="\255\216\255")
                    or (spec[2]=="png" and data:sub(1,8)=="\137PNG\13\10\26\10")
                if valid and pcall(writefile,filename,data) then
                    local success,result=pcall(custom,filename)
                    if success then url=result end
                end
            end
        end
        if state.alive and type(url)=="string" then
            for _,target in ipairs(spec[3])do target.Image=url end
        end
    end)
end
