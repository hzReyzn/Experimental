local phase=0
local elapsed=0
local lastPaint=0
connect(RunService.RenderStepped,function(dt)
    elapsed+=dt
    if elapsed<1/60 then return end
    dt=elapsed;elapsed=0
    phase+=dt
    state.phase=phase
    state.burst=math.max(0,state.burst-dt*2.4)
    VFX.reflections:update(dt)
    if UI.window.Visible then
        UI.fire:update(phase,state.burst)
        UI.panelFx.inward:update(phase,state.burst)
        UI.panelFx.neon:update(phase,.12)
        UI.panelFx.beamGradient.Offset=Vector2.new(math.sin(phase*.24)*.35,0)
        -- The Fly and direction settings reuse the original animated chrome.
    end
    if UI.launcher.Visible then UI.launcherFire:update(phase,state.burst) end
    if UI.pad.Visible then padFx:update(phase,.13) end
    for _,record in ipairs(buttons)do
        record.neon:update(phase,.09+record.selection.Value*.13+record.energy.Value*.04)
        record.selectedGradient.Offset=record.neon.wash.Offset
    end
    UI.launcherLetter.Visible=UI.launcherImage.Image=="" or not UI.launcherImage.IsLoaded
    if phase-lastPaint>=.2 then
        lastPaint=phase
        local message
        if not features.fly.enabled then message="OFF"
        elseif armed.mode=="vehicle" then message="VEHICLE FLYING"
        elseif armed.mode=="character" then message="PLAYER FLYING"
        else message="ARMED" end
        if message~=lastStatus then UI.status.Text=message;lastStatus=message end
    end
end)
return UI.gui
