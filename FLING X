local function cleanup()
    if not S.alive then return end
    -- Stop physics synchronously before disconnecting anything; re-execution
    -- cannot leave the previous instance spinning or holding a camera subject.
    pcall(function() S.noFallLease:destroy() end)
    pcall(function() Engine.stop(nil, false, true) end)
    pcall(Engine.releasePhysics)
    pcall(Engine.restoreNoclip)
    pcall(Engine.clearGuards)
    S.alive = false
    disconnect(S.links)
    disconnect(S.characterLinks)
    for _, row in pairs(S.rows) do disconnect(row.links) end
    for _, tween in pairs(S.tweens) do tween:Cancel() end
    table.clear(S.tweens)
    S.drag = nil
    if S.assetThread and coroutine.status(S.assetThread) ~= "dead" then pcall(task.cancel, S.assetThread) end
end
