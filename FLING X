-- Reyzn X grayscale texture, rendered as overlapping charcoal veils, silver
-- hot cores and cooling tips. Turbulence is continuous; particles are pooled.
local FIRE = {
    url = "https://raw.githubusercontent.com/hzReyzn/Ghislain/893c7cbd037b8359974923abf8261a1d08f4215a/assets/reyzn-x/flame-wisp-v1.png",
    file = "FlingX-reyzn-fire-v1.png", bytes = 1172326,
    image = "rbxasset://textures/particles/fire_main.dds", images = {}, custom = false,
}
local function fireImage(parent, name, core)
    local image = make("ImageLabel", parent, {Name = name, BackgroundTransparency = 1, Image = FIRE.image,
        ImageColor3 = C.white, ImageTransparency = 1, AnchorPoint = Vector2.new(.5, 1),
        ScaleType = Enum.ScaleType.Stretch, ZIndex = core and 2 or 1, Active = false})
    local wash = gradient(image, core and {C.silver, C.white, C.white, C.silver} or {C.steel, C.silver, C.white, C.silver}, 90)
    -- A rooted flame must retain its bright base. The old bottom alpha=1 made
    -- every sprite float separately above the frame like a row of small icons.
    wash.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, .55), NumberSequenceKeypoint.new(.24, .12),
        NumberSequenceKeypoint.new(.68, 0), NumberSequenceKeypoint.new(1, .04)})
    FIRE.images[#FIRE.images + 1] = image
    return image
end
local function createFire(parent, name, miniature)
    local host = frame(parent, name, UDim2.new(), miniature and UDim2.fromOffset(56, 56) or UDim2.new(1, 0, 1, -26), nil, 1, miniature and 4 or 1)
    host.Active = false
    local effect = {host = host, roots = {}, embers = {}, fields = {}, miniature = miniature}
    -- Two layers per root instead of three. More closely packed roots produce a
    -- continuous perimeter, while the pool stays fixed throughout the session.
    local counts = miniature and {9, 5, 8, 5} or {32, 12, 28, 12}
    for side, count in ipairs(counts) do
        for i = 1, count do
            local seed = side * 19.73 + i * 2.713
            effect.roots[#effect.roots + 1] = {
                side = side, fraction = (i - .5) / count, seed = seed, count = count,
                body = fireImage(host, "FlowingFlame", false), core = fireImage(host, "HotFilament", true),
                height = .78 + (math.sin(seed * 9.17) * .5 + .5) * .44,
            }
        end
    end
    for side = 1, 4 do
        local field = frame(host, "EdgeRadiance", UDim2.new(), UDim2.new(), C.white, 1, 1)
        local wash = gradient(field, {C.steel, C.silver, C.white}, (side == 1 or side == 3) and 90 or 0)
        wash.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.25, .93),
            NumberSequenceKeypoint.new(.5, .40), NumberSequenceKeypoint.new(.75, .93), NumberSequenceKeypoint.new(1, 1)})
        corner(field, 14)
        effect.fields[side] = field
    end
    for i = 1, miniature and 9 or 20 do
        local ember = frame(host, "RisingEmber", UDim2.new(), UDim2.fromOffset(i % 3 == 0 and 1.8 or 1.1, 2.5), C.white, 1, 2)
        corner(ember, 2)
        effect.embers[#effect.embers + 1] = {node = ember, seed = i * 1.937}
    end
    S.fire[#S.fire + 1] = effect
    return effect
end
