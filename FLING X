local function animate(object, seconds, properties)
    local old = S.tweens[object]
    if old then old:Cancel() end
    local tween = TweenService:Create(object, TweenInfo.new(seconds, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    S.tweens[object] = tween
    tween:Play()
    return tween
end
local function finite(n) return n == n and math.abs(n) < 10000000 end
local function validVector(v) return finite(v.X) and finite(v.Y) and finite(v.Z) end
local function bottom()
    local value = Workspace.FallenPartsDestroyHeight
    return finite(value) and value or -500
end
local function avatar(player)
    local character = player and player.Character
    if not character or not character.Parent then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not hum or hum.Health <= 0 then return nil end
    return character, root, hum
end

local createNoFallLease = (function()
-- Shared, client-local ownership of a velocity pulse. No callbacks yield here.
-- The ledger lives in PlayerGui so separately executed scripts can cooperate
-- without depending on shared Lua globals or on signal delivery order.
return function(ownerGui, priority)
    local parent = ownerGui.Parent
    local ledger = parent:FindFirstChild("ReyznNoFallDamage_v1")
    local function value(class, name, container, initial)
        local object = Instance.new(class)
        object.Name = name
        object.Value = initial
        object.Parent = container
        return object
    end
    if not ledger then
        ledger = Instance.new("Folder")
        ledger.Name = "ReyznNoFallDamage_v1"
        local clients = Instance.new("Folder")
        clients.Name = "Clients"
        clients.Parent = ledger
        value("ObjectValue", "Owner", ledger, nil)
        value("ObjectValue", "PendingOwner", ledger, nil)
        value("ObjectValue", "Root", ledger, nil)
        value("ObjectValue", "Character", ledger, nil)
        value("Vector3Value", "Velocity", ledger, ZERO)
        ledger.Parent = parent
    end
    local clients = ledger:FindFirstChild("Clients")
    local owner = ledger:FindFirstChild("Owner")
    local pending = ledger:FindFirstChild("PendingOwner")
    local rootValue = ledger:FindFirstChild("Root")
    local characterValue = ledger:FindFirstChild("Character")
    local velocityValue = ledger:FindFirstChild("Velocity")
    local token = value("ObjectValue", ownerGui.Name.."Lease", clients, ownerGui)
    token:SetAttribute("Priority", priority)
    token:SetAttribute("Enabled", false)
    local disposed = false
    local destructionConnection
    local lease = {changed = owner:GetPropertyChangedSignal("Value")}

    local function restorePending()
        local root, character, velocity = rootValue.Value, characterValue.Value, velocityValue.Value
        pending.Value = nil
        rootValue.Value = nil
        characterValue.Value = nil
        if root and character and root.Parent == character and not root.Anchored
            and root.AssemblyLinearVelocity == ZERO then
            root.AssemblyLinearVelocity = velocity
        end
    end
    local function chooseOwner()
        local winner, best = nil, -math.huge
        for _, candidate in ipairs(clients:GetChildren()) do
            local gui = candidate.Value
            local rank = candidate:GetAttribute("Priority")
            if gui and gui.Parent == parent and candidate:GetAttribute("Enabled") and rank > best then
                winner, best = candidate, rank
            end
        end
        if owner.Value ~= winner then
            -- Finish the outgoing pulse before publishing the incoming owner.
            -- A queued restore from the old script then cannot touch the new one.
            restorePending()
            owner.Value = winner
        end
    end
    function lease:isOwner()
        return not disposed and owner.Value == token and token:GetAttribute("Enabled") == true
    end
    function lease:setEnabled(enabled)
        if disposed then return end
        if token:GetAttribute("Enabled") ~= enabled then
            token:SetAttribute("Enabled", enabled)
            chooseOwner()
        end
    end
    function lease:restore()
        if not disposed and pending.Value == token then restorePending() end
    end
    -- Other cooperating controllers read the real velocity even between the
    -- zeroing and restoration phases. A correction invalidates that old pulse,
    -- including corrections to zero, so it cannot be undone by a queued restore.
    function lease:readVelocity(root)
        local saved=not disposed and rootValue.Value
        if saved and pending.Value and saved.Parent == characterValue.Value
            and (saved==root or saved.AssemblyRootPart==root.AssemblyRootPart)
            and root.AssemblyLinearVelocity == ZERO then
            return velocityValue.Value
        end
        return root.AssemblyLinearVelocity
    end
    function lease:writeVelocity(root, velocity)
        if disposed or not root.Parent then return end
        local saved=rootValue.Value
        if saved and (saved==root or saved.AssemblyRootPart==root.AssemblyRootPart) then
            pending.Value = nil
            rootValue.Value = nil
            characterValue.Value = nil
        end
        root.AssemblyLinearVelocity = velocity
    end
    function lease:pulse(root)
        if not self:isOwner() then return false end
        self:restore()
        if not root.Parent or root.Anchored then return false end
        rootValue.Value = root
        characterValue.Value = root.Parent
        velocityValue.Value = root.AssemblyLinearVelocity
        pending.Value = token
        root.AssemblyLinearVelocity = ZERO
        return true
    end
    function lease:destroy()
        if disposed then return end
        self:restore()
        self:setEnabled(false)
        disposed = true
        if destructionConnection then destructionConnection:Disconnect() end
        token:Destroy()
        if #clients:GetChildren() == 0 then ledger:Destroy() end
    end
    destructionConnection = ownerGui.Destroying:Connect(function() lease:destroy() end)
    return lease
end
end)()
-- NDS uses the same no-fall lease protocol as Reyzn X. The main Hub keeps
-- priority 100; this standalone fallback uses 50, never double-pulsing a root.
local NoFall = {supported = game.PlaceId == 189707}
function NoFall.refresh()
    if S.noFallLease then S.noFallLease:setEnabled(NoFall.supported and S.nofall) end
end
function NoFall.restore()
    if S.noFallLease then S.noFallLease:restore() end
end
function NoFall.pulse()
    if not NoFall.supported or not S.nofall or not S.noFallLease then return end
    local character, root = avatar(LP)
    if character == S.character and root and not root.Anchored and root.Position.Y > bottom() + 4 then
        S.noFallLease:pulse(root)
    end
end

-- Respect Reyzn X's no-fall pulse if it is present. Never acquire, disable, or
-- replace its owner; an intentional correction only updates the saved velocity.
local function noFallValues(root)
    local ledger = PlayerGui:FindFirstChild("ReyznNoFallDamage_v1")
    if not ledger then return nil end
    local pending, saved, velocity = ledger:FindFirstChild("PendingOwner"), ledger:FindFirstChild("Root"), ledger:FindFirstChild("Velocity")
    if pending and saved and velocity and pending.Value and saved.Value == root then return velocity end
    return nil
end
local function readVelocity(root)
    local saved = noFallValues(root)
    if saved and root.AssemblyLinearVelocity == ZERO then return saved.Value end
    return root.AssemblyLinearVelocity
end
local function clearVelocity(root)
    if not root or not root.Parent or root.Anchored then return end
    local saved = noFallValues(root)
    if saved then saved.Value = ZERO end
    root.AssemblyLinearVelocity = ZERO
    root.AssemblyAngularVelocity = ZERO
end
local function status(text, seconds)
    S.statusText = text
    S.statusUntil = os.clock() + (seconds or 0)
    if UI.status then UI.status.Text = text end
end

-- Original values are captured on the first write and restored on stop, death,
-- reload and GUI destruction. Noclip has its own ledger, outside the fling lease.
function Engine.restoreNoclip()
    for part, original in pairs(S.clipped) do
        if part.Parent then part.CanCollide = original end
    end
    table.clear(S.clipped)
end
function Engine.noclipStep()
    if S.mode == "fling" or S.mode == "recover" then return end
    if not S.noclip then Engine.restoreNoclip(); return end
    for part in pairs(S.localParts) do
        if part.Parent then
            if S.clipped[part] == nil then S.clipped[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end
function Engine.releasePhysics()
    local lease = S.restore
    S.restore = nil
    if not lease then return end
    if lease.mapFolder then lease.mapFolder:Destroy() end
    for part, saved in pairs(lease.parts) do
        if part.Parent then
            part.CanCollide = saved.collide
            part.CustomPhysicalProperties = saved.physical
        end
    end
    local hum = lease.hum
    if hum and hum.Parent then
        hum.AutoRotate = lease.autoRotate
        hum.PlatformStand = lease.platform
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, lease.seated)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, lease.falling)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, lease.ragdoll)
        if hum.Health > 0 and not lease.platform then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    local camera = lease.camera
    if camera and Workspace.CurrentCamera == camera and camera.CameraSubject == lease.watch then
        local _, _, currentHum = avatar(LP)
        camera.CameraSubject = (lease.subject and lease.subject.Parent and lease.subject) or currentHum
    end
    clearVelocity(lease.root)
end
local function bodyCore(part)
    local name = part.Name
    return name == "HumanoidRootPart" or name == "Head" or name == "Torso"
        or name == "UpperTorso" or name == "LowerTorso"
end
function Engine.acquirePhysics(character, root, hum, targetHum)
    Engine.restoreNoclip()
    local camera = Workspace.CurrentCamera
    S.restore = {parts = {}, hum = hum, root = root, autoRotate = hum.AutoRotate,
        platform = hum.PlatformStand, seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated),
        falling = hum:GetStateEnabled(Enum.HumanoidStateType.FallingDown),
        ragdoll = hum:GetStateEnabled(Enum.HumanoidStateType.Ragdoll),
        camera = camera, subject = camera and camera.CameraSubject, watch = targetHum,
        mapFolder = make("Folder", character, {Name = "FlingXContactGuards"}), mapPairs = {}, mapAt = 0}
    for part in pairs(S.localParts) do
        if part.Parent then
            S.restore.parts[part] = {collide = part.CanCollide, physical = part.CustomPhysicalProperties}
            if part == root then part.CustomPhysicalProperties = PhysicalProperties.new(5, .65, 0, 100, 100) end
            part.CanCollide = false
        end
    end
    hum.AutoRotate = false
    hum.Sit = false
    hum.PlatformStand = true
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    if camera then camera.CameraSubject = targetHum end
end

-- Prevent the contact collider from striking scenery. This is a bounded nearby
-- query, never a scan of the whole map; the target is excluded from these guards.
function Engine.guardScenery(position, now)
    local lease = S.restore
    if not lease or now < lease.mapAt then return end
    lease.mapAt = now + .08
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then excluded[#excluded + 1] = player.Character end
    end
    params.FilterDescendantsInstances = excluded
    params.MaxParts = 96
    params.RespectCanCollide = true
    local seen = {}
    for _, part in ipairs(Workspace:GetPartBoundsInRadius(position, 9, params)) do
        if part:IsA("BasePart") and part.CanCollide then
            seen[part] = true
            if not lease.mapPairs[part] then
                lease.mapPairs[part] = make("NoCollisionConstraint", lease.mapFolder,
                    {Name = "SceneryGuard", Part0 = S.root, Part1 = part, Enabled = true})
            end
        end
    end
    for part, constraint in pairs(lease.mapPairs) do
        if not seen[part] then constraint:Destroy(); lease.mapPairs[part] = nil end
    end
end

-- Only local collision constraints are used for Anti-Fling. Other players'
-- CanCollide, velocity and humanoids are never modified.
function Engine.clearGuards(player)
    if player then
        local record = S.guards[player]
        if record then record.folder:Destroy(); S.guards[player] = nil end
    else
        for other, record in pairs(S.guards) do record.folder:Destroy(); S.guards[other] = nil end
    end
end
function Engine.updateGuards()
    if not S.anti or not S.root or not S.root.Parent then Engine.clearGuards(); return end
    local seen = {}
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LP and other ~= S.target then
            local character, root = avatar(other)
            if root then
                local distance = (root.Position - S.root.Position).Magnitude
                local speed = root.AssemblyLinearVelocity.Magnitude
                local radius = math.clamp(56 + (finite(speed) and speed or 600) * .15, 56, 160)
                if distance <= radius then
                    seen[other] = true
                    local record = S.guards[other]
                    if record and record.character ~= character then Engine.clearGuards(other); record = nil end
                    if not record then
                        record = {character = character, pairs = {}, folder = make("Folder", S.character, {Name = "FlingXGuard_" .. other.UserId})}
                        S.guards[other] = record
                    end
                    local remoteParts = {}
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and (bodyCore(part) or part.CanCollide) then remoteParts[part] = true end
                    end
                    local localParts = {}
                    for part in pairs(S.localParts) do
                        local saved = S.clipped[part]
                        local leased = S.restore and S.restore.parts[part]
                        if part.Parent and (bodyCore(part) or part.CanCollide or saved == true or (leased and leased.collide)) then
                            localParts[part] = true
                        end
                    end
                    for localPart, pairsForPart in pairs(record.pairs) do
                        for remotePart, constraint in pairs(pairsForPart) do
                            if not localParts[localPart] or not remoteParts[remotePart] then
                                constraint:Destroy(); pairsForPart[remotePart] = nil
                            end
                        end
                        if not localParts[localPart] then record.pairs[localPart] = nil end
                    end
                    for localPart in pairs(localParts) do
                        local pairsForPart = record.pairs[localPart] or {}
                        record.pairs[localPart] = pairsForPart
                        for remotePart in pairs(remoteParts) do
                            if not pairsForPart[remotePart] then
                                pairsForPart[remotePart] = make("NoCollisionConstraint", record.folder,
                                    {Name = "LocalGuard", Part0 = localPart, Part1 = remotePart, Enabled = true})
                            end
                        end
                    end
                end
            end
        end
    end
    for other in pairs(S.guards) do if not seen[other] then Engine.clearGuards(other) end end
end

function Engine.ground(root)
    local excluded = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then excluded[#excluded + 1] = player.Character end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true
    params.RespectCanCollide = true
    local height = math.max(6, (S.hum and S.hum.HipHeight or 2) + root.Size.Y / 2 + 2)
    return Workspace:Raycast(root.Position, Vector3.new(0, -height, 0), params)
end
function Engine.snapshot(grounded)
    local character, root = avatar(LP)
    if not character or not validVector(root.Position) or root.Position.Y < bottom() + 30 then return nil end
    local hit = grounded and Engine.ground(root) or nil
    if grounded and not hit then return nil end
    local result = {character = character, root = root, cf = root.CFrame,
        offset = root.CFrame:ToObjectSpace(character:GetPivot()), epoch = S.epoch}
    if hit and hit.Instance and hit.Instance:IsA("BasePart") then
        if not hit.Instance.Anchored then return nil end
        result.support = hit.Instance
        result.relative = hit.Instance.CFrame:ToObjectSpace(root.CFrame)
    end
    return result
end
function Engine.resolve(snapshot)
    if not snapshot or snapshot.epoch ~= S.epoch or snapshot.character ~= LP.Character or snapshot.root ~= S.root then return nil end
    local cf = snapshot.cf
    if snapshot.support then
        if not snapshot.support:IsDescendantOf(Workspace) then return nil end
        cf = snapshot.support.CFrame * snapshot.relative
    end
    if not validVector(cf.Position) or cf.Position.Y < bottom() + 24 then return nil end
    return cf
end
function Engine.place(snapshot)
    local cf = Engine.resolve(snapshot)
    if not cf or not S.character or not S.root or S.root.Anchored then return false end
    clearVelocity(S.root)
    S.character:PivotTo(cf * snapshot.offset)
    clearVelocity(S.root)
    return true
end
function Engine.saveGround(now)
    if S.enabled or S.mode ~= "idle" or now < S.safeAt then return end
    S.safeAt = now + .12
    local _, root, hum = avatar(LP)
    if root and not root.Anchored and not hum.Sit and not hum.PlatformStand then
        local velocity = readVelocity(root)
        if validVector(velocity) and velocity.Magnitude < 90 and math.abs(velocity.Y) < 25 then
            local snap = Engine.snapshot(true)
            if snap then S.safe = snap end
        end
    end
end

function Engine.isSelected(player)
    return player ~= LP and (S.all or S.selected[player.UserId] == true)
end
function Engine.targets()
    local queue = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if Engine.isSelected(player) then queue[#queue + 1] = player end
    end
    table.sort(queue, function(a, b) return a.UserId < b.UserId end)
    return queue
end
function Engine.refresh()
    if not UI.action then return end
    local running = S.enabled or S.resumeWanted
    UI.actionText.Text = S.resumeWanted and "WAITING" or (S.healthPaused and S.enabled and "FLING  PAUSED") or (S.enabled and "FLING  ON" or "FLING  OFF")
    UI.actionMark.Text = running and "■" or "→"
    UI.actionText.TextColor3 = running and C.coal or C.white
    UI.actionMark.TextColor3 = UI.actionText.TextColor3
    UI.actionGradient.Color = running and ColorSequence.new(C.white, C.silver) or ColorSequence.new(C.steel, C.dark)
    UI.activeDot.BackgroundColor3 = S.enabled and C.white or C.steel
    UI.gui:SetAttribute("FlingEnabled", S.enabled)
    UI.gui:SetAttribute("Mode", S.mode)
end
function Engine.beginRecovery(destination, message, final)
    S.target, S.attack = nil, nil
    Engine.releasePhysics()
    clearVelocity(S.root)
    S.recovery = destination
    S.mode = "recover"
    S.recoverUntil = os.clock() + .22
    S.finalRecovery = final
    S.guardAt = 0
    if destination and not Engine.place(destination) then
        S.recovery = S.safe
        if not Engine.place(S.safe) then S.recovery = nil; message = "Return position unavailable" end
    end
    if message then status(message, 2.5) end
    Engine.refresh()
end
function Engine.stop(message, emergency, immediate)
    local hadSession = S.enabled or S.mode == "fling" or S.mode == "recover" or S.restore ~= nil
    S.enabled, S.resumeWanted, S.healthPaused = false, false, false
    S.pauseUntil = 0
    local destination
    if emergency then
        destination = (Engine.resolve(S.safe) and S.safe) or (Engine.resolve(S.origin) and S.origin) or nil
    elseif hadSession and S.back then destination = S.origin end
    if hadSession then
        Engine.beginRecovery(destination, message or "Stopped", true)
    else
        Engine.releasePhysics()
        S.target, S.attack = nil, nil
        S.mode = "idle"
        if message then status(message, 2.5) end
    end
    if immediate then
        if destination then Engine.place(destination) end
        S.mode, S.recovery, S.origin = "idle", nil, nil
        Engine.restoreNoclip()
    end
    Engine.refresh()
end
function Engine.characterLost(message)
    local resume = S.loop and (S.enabled or S.resumeWanted)
    Engine.stop(message, false, true)
    S.resumeWanted = resume
    Engine.refresh()
end
function Engine.start()
    if S.enabled or S.resumeWanted then Engine.stop("Stopped"); return end
    if S.mode == "recover" then status("Stabilizing", .5); return end
    local character, root, hum = avatar(LP)
    if not character or character ~= S.character then status("Waiting for character", 3); return end
    if root.Anchored then status("Character is anchored", 3); return end
    if hum.Sit or hum.SeatPart or hum.PlatformStand then status("Stand up first", 3); return end
    if hum.Health < hum.MaxHealth * .65 then status("Health too low", 3); return end
    local queue = Engine.targets()
    if #queue == 0 and not (S.all and S.loop) then status("Select a player", 3); return end
    S.origin = Engine.snapshot(true) or Engine.snapshot(false)
    if not S.origin then status("Move to safe ground", 3); return end
    if NoFall.supported then
        S.nofall = true; NoFall.refresh()
        if UI.switches then UI.switches.nofall.refresh(true) end
    end
    S.queue, S.cursor, S.nextAt, S.completed = queue, 0, os.clock(), 0
    S.pauseUntil, S.healthPaused = 0, false
    S.enabled, S.mode, S.passObserved = true, "wait", false
    status("Starting")
    Engine.refresh()
end
function Engine.nextTarget(now)
    if now < S.nextAt or not S.enabled then return end
    if now < S.pauseUntil then return end
    if S.healthPaused then
        if S.hum.Health < S.hum.MaxHealth * .80 then return end
        S.healthPaused = false; Engine.refresh()
    end
    if S.cursor >= #S.queue then
        if not S.loop then
            Engine.stop(S.passObserved and "Cycle complete" or "No launch observed")
            return
        end
        S.queue, S.cursor = Engine.targets(), 0
        if #S.queue == 0 then
            if S.all then S.nextAt = now + 1; status("Waiting for players"); return end
            Engine.stop("Select a player"); return
        end
        S.passObserved = false
    end
    S.cursor = S.cursor + 1
    local player = S.queue[S.cursor]
    if player.Parent ~= Players or not Engine.isSelected(player) or now < (S.avoidUntil[player.UserId] or 0) then S.nextAt = now + .12; return end
    local targetChar, targetRoot, targetHum = avatar(player)
    if not targetChar or targetRoot.Anchored or targetChar:FindFirstChildOfClass("ForceField") or not validVector(targetRoot.Position)
        or targetRoot.Position.Y <= bottom() + 70 then
        status("Target unavailable", 1); S.nextAt = now + .25; return
    end
    local character, root, hum = avatar(LP)
    if not character or root.Anchored or hum.SeatPart then Engine.stop("Character unavailable", true); return end
    local contact = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetRoot
    S.target = player
    Engine.clearGuards(player)
    Engine.acquirePhysics(character, root, hum, targetHum)
    S.attack = {player = player, character = targetChar, root = targetRoot, hum = targetHum,
        contact = contact, started = now, initial = targetRoot.Position, frame = 0, initialHealth = hum.Health,
        offset = root.CFrame:ToObjectSpace(character:GetPivot())}
    S.mode = "fling"
    status("Fling · " .. player.DisplayName)
    Engine.refresh()
end
function Engine.finishTarget(message, observed)
    if not S.attack and S.mode ~= "fling" then return end
    if observed then S.passObserved = true end
    S.completed = S.completed + 1
    Engine.beginRecovery(S.back and S.origin or nil, message, false)
end
function Engine.healthChanged(health)
    local previous = S.lastHealth or health
    S.lastHealth = health
    if not S.enabled or health <= 0 or health >= previous - .1 then return end
    local target = S.target
    if target then S.avoidUntil[target.UserId] = os.clock() + 12 end
    S.pauseUntil = os.clock() + 3
    S.healthPaused = health < S.hum.MaxHealth * .65
    local destination = (Engine.resolve(S.origin) and S.origin) or S.safe
    Engine.beginRecovery(destination, S.healthPaused and "Health low · paused" or "Damage detected · returned", false)
end
function Engine.pulse(now, dt)
    local attack = S.attack
    if not attack or not S.target or not Engine.isSelected(S.target) then
        Engine.finishTarget("Target deselected"); return
    end
    if attack.player.Parent ~= Players or attack.player.Character ~= attack.character or not attack.root.Parent or attack.hum.Health <= 0 then
        Engine.finishTarget("Target unavailable"); return
    end
    if not attack.contact.Parent or attack.root.Anchored then Engine.finishTarget("Target unavailable"); return end
    local targetPos = attack.contact.Position
    local targetVelocity = attack.root.AssemblyLinearVelocity
    if not validVector(targetPos) or not validVector(targetVelocity) or targetPos.Y <= bottom() + 70 then
        Engine.finishTarget("Target out of range"); return
    end
    local elapsed = now - attack.started
    if S.hum.Health < attack.initialHealth - .1 then Engine.healthChanged(S.hum.Health); return end
    if targetPos.Y < attack.initial.Y - 16 then Engine.finishTarget("Target falling", true); return end
    if elapsed > .15 and ((attack.root.Position - attack.initial).Magnitude > 55 or targetVelocity.Magnitude > 180) then
        Engine.finishTarget("Launch observed", true); return
    end
    if elapsed > (S.high and 1.6 or 2) then Engine.finishTarget("No launch observed"); return end
    attack.frame = attack.frame + 1
    local angle = elapsed * (S.high and 30 or 22)
    local lead = targetVelocity.Magnitude > 75 and targetVelocity.Unit * 1.5 or targetVelocity * math.min(dt, .02)
    local radius = math.clamp((attack.contact.Size.X + S.root.Size.X) * .25, .7, 1.35)
    local radial = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
    local center = targetPos + Vector3.new(lead.X, .65, lead.Z)
    local position = center + radial
    local direction = (center - position).Unit
    local rotation = CFrame.Angles(0, angle, 0)
    attack.pose = CFrame.new(position) * rotation
    for part in pairs(S.localParts) do
        if part.Parent then
            -- Include accessories added while a pulse is running in the restore ledger.
            if not S.restore.parts[part] then S.restore.parts[part] = {collide = part.CanCollide, physical = part.CustomPhysicalProperties} end
            -- One upright contact collider; head/limbs do not strike the map.
            part.CanCollide = part == S.root
        end
    end
    S.hum.PlatformStand = true
    Engine.guardScenery(position, now)
    S.character:PivotTo(attack.pose * attack.offset)
    -- Rotational contact transfers the impulse without the old 18,000 studs/s
    -- linear launch and vertical kick. No infinities, NaNs or global physics edits.
    S.root.AssemblyLinearVelocity = direction * (S.high and 36 or 24)
    S.root.AssemblyAngularVelocity = Vector3.new(0, S.high and 12000 or 6500, 0)
end
function Engine.emergency(now)
    if not S.root or not S.root.Parent or S.root.Anchored then return false end
    local position = S.root.Position
    local velocity = readVelocity(S.root)
    local invalid = not validVector(position) or not validVector(velocity)
    local fallingFast = validVector(velocity) and math.max(0, -velocity.Y) or 0
    local margin = math.clamp(fallingFast * .22, 65, 170)
    if invalid or (S.void and position.Y < bottom() + margin) then
        if Engine.resolve(S.safe) or Engine.resolve(S.origin) then
            if S.enabled or S.mode == "fling" then Engine.stop("Void recovered", true)
            else
                clearVelocity(S.root)
                if not Engine.place(S.safe) then Engine.place(S.origin) end
                S.guardCooldown = now + .5
                if now >= S.statusUntil then status("Void recovered", 2) end
            end
        else
            if S.enabled then Engine.stop("No safe position", true) end
            if now >= S.statusUntil then status("No safe position", 3) end
        end
        return true
    end
    if (S.self or S.anti) and S.mode ~= "fling" and now > (S.guardCooldown or 0) then
        local angular = S.root.AssemblyAngularVelocity
        local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        if horizontal > 260 or velocity.Y > 300 or not validVector(angular) or angular.Magnitude > 150 then
            clearVelocity(S.root)
            if S.self and S.mode ~= "recover" then Engine.place(S.safe) end
            S.guardCooldown = now + .4
            status("Fling blocked", 2)
        end
    end
    return false
end
function Engine.pre(dt)
    NoFall.restore()
    local now = os.clock()
    local character, root, hum = avatar(LP)
    if not character or character ~= S.character or root ~= S.root then
        if S.enabled or S.restore then Engine.characterLost("Waiting for character") end
        return
    end
    if hum.Health <= 0 or root.Anchored then
        if S.enabled or S.restore then Engine.stop("Character unavailable", false, true) end
        return
    end
    if S.enabled and hum.Health < hum.MaxHealth * .65 and not S.healthPaused then
        S.healthPaused = true
        S.pauseUntil = now + 3
        Engine.beginRecovery((Engine.resolve(S.origin) and S.origin) or S.safe, "Health low · paused", false)
    end
    if Engine.emergency(now) then return end
    if S.mode == "recover" then
        if S.recovery then Engine.place(S.recovery) end
        clearVelocity(root)
        if now >= S.recoverUntil then
            S.recovery = nil
            if S.enabled and not S.finalRecovery then S.mode = "wait"; S.nextAt = now + (S.loop and .45 or .12)
            else S.mode = "idle"; S.origin = nil end
            Engine.refresh()
        end
    elseif S.mode == "wait" then Engine.nextTarget(now)
    elseif S.mode == "fling" then Engine.pulse(now, dt) end
    Engine.noclipStep()
    Engine.saveGround(now)
    if S.resumeWanted and S.loop and now >= (S.resumeAt or 0) and Engine.resolve(S.safe) and hum.Health >= hum.MaxHealth * .80 then
        S.resumeWanted = false
        Engine.start()
    end
    if now >= S.guardAt then S.guardAt = now + .2; Engine.updateGuards() end
end
function Engine.post()
    if S.mode == "fling" and S.attack and S.root and S.root.Parent then
        -- Pulse only across physics, never leave dangerous momentum for rendering
        -- or for the no-fall Heartbeat sampler.
        clearVelocity(S.root)
        if S.attack.pose and ((S.root.Position - S.attack.pose.Position).Magnitude > 70 or S.root.Position.Y < S.attack.pose.Position.Y - 9) then
            S.pauseUntil = os.clock() + 1
            Engine.beginRecovery((Engine.resolve(S.origin) and S.origin) or S.safe, "Unstable contact · returned", false)
            return
        end
        if S.self and S.attack.pose and LP.Character == S.character then
            S.character:PivotTo(S.attack.pose * S.attack.offset)
        end
    end
end
function Engine.bind(character)
    local resume = S.resumeWanted or (S.enabled and S.loop)
    NoFall.restore()
    Engine.stop(nil, false, true)
    S.resumeWanted = resume
    S.resumeAt = os.clock() + .8
    disconnect(S.characterLinks)
    Engine.clearGuards()
    S.epoch = S.epoch + 1
    S.character, S.root, S.hum, S.safe, S.origin = character, nil, nil, nil, nil
    table.clear(S.localParts)
    local epoch = S.epoch
    if not character then return end
    local function added(part)
        if epoch ~= S.epoch then return end
        if part:IsA("BasePart") then S.localParts[part] = true end
        if part.Name == "HumanoidRootPart" and part:IsA("BasePart") then S.root = part end
        if part:IsA("Humanoid") then
            S.hum = part
            S.lastHealth = part.Health
            link(part.HealthChanged, function(health) if part == S.hum then Engine.healthChanged(health) end end, S.characterLinks)
            link(part.Died, function()
                if part ~= S.hum then return end
                Engine.characterLost("Respawning")
                S.safe, S.origin = nil, nil
                Engine.refresh()
            end, S.characterLinks)
        end
    end
    for _, part in ipairs(character:GetDescendants()) do added(part) end
    link(character.DescendantAdded, added, S.characterLinks)
    link(character.DescendantRemoving, function(part)
        S.localParts[part] = nil
        if S.clipped[part] ~= nil then
            pcall(function() part.CanCollide = S.clipped[part] end)
            S.clipped[part] = nil
        end
        if part == S.root then Engine.characterLost("Character unavailable"); S.root = nil; S.safe = nil end
    end, S.characterLinks)
    S.safeAt, S.guardAt = 0, 0
end

