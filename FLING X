    local counts = miniature and {4, 2, 3, 2} or {9, 5, 8, 5}
    for side, count in ipairs(counts) do
        for i = 1, count do
            local seed = side * 4.73 + i * 1.71
            local root = {side = side, fraction = (i - .5) / count, seed = seed, count = count,
                veil = fireImage(host, "CharcoalVeil", false), body = fireImage(host, "SilverFlame", false),
                core = fireImage(host, "HotCore", true)}
