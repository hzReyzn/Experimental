end
local function gradient(object, colors, rotation)
    local keys = {}
    for i, color in ipairs(colors) do
        keys[i] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color)
    end
    return make("UIGradient", object, {Color = ColorSequence.new(keys), Rotation = rotation or 90})
end
