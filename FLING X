    animate(UI.fade, .18, {Value = 0})
    animate(UI.scale, .18, {Scale = .96})
    task.delay(.2, function() if S.alive then UI.gui:Destroy() end end)
end)
link(LP.CharacterAdded, Engine.bind)
link(LP.CharacterRemoving, function(character) if S.character == character then Engine.bind(nil) end end)
link(Players.PlayerAdded, UI.addPlayer)
link(Players.PlayerRemoving, UI.removePlayer)

local function physicsError(message)
    warn("Fling X: " .. tostring(message))
    Engine.stop("Stopped · physics error", true, true)
end
link(RunService.PreSimulation, function(dt)
    if S.closing then return end
    local ok, message = xpcall(function() Engine.pre(dt) end, debug.traceback)
    if not ok then physicsError(message) end
end)
link(RunService.PostSimulation, function()
    if S.closing then return end
    local ok, message = xpcall(Engine.post, debug.traceback)
    if not ok then physicsError(message) end
end)
link(RunService.RenderStepped, NoFall.restore)
link(RunService.Heartbeat, function(dt)
    NoFall.pulse()
    S.clock = S.clock + dt
    S.budget = S.budget + dt
    local interval = dt > .05 and 1 / 20 or 1 / 30
    if not S.focused or S.budget < interval then return end
    S.budget = S.budget % interval
    if UI.window.Visible then
        drawFire(UI.fire, S.clock, UI.fade.Value)
        for i, sweep in ipairs(S.sheens) do
            sweep.Offset = Vector2.new(-1.25 + 2.5 * math.min(1, ((S.clock + i * .4) % 9) / 2), 0)
        end
    end
    if UI.launcher.Visible then
        UI.miniFire.host.Position = UI.launcher.Position
        drawFire(UI.miniFire, S.clock, 1)
    end
    UI.miniDot.Visible = S.enabled or S.resumeWanted
    if not S.enabled and S.mode == "idle" and S.statusUntil > 0 and os.clock() > S.statusUntil then
        S.statusUntil = 0; status("Ready")
    end
end)

Engine.bind(LP.Character)
for _, player in ipairs(Players:GetPlayers()) do UI.addPlayer(player) end
UI.selectPage("Targets")
UI.refreshSelection()
UI.resize(true)
Engine.refresh()
applyFade()
animate(UI.fade, .38, {Value = 1})
animate(UI.scale, .4, {Scale = 1})
S.assetThread = task.defer(loadFire)
return UI.gui
