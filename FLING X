local function link(signal, fn, bag)
    local connection = signal:Connect(function(...)
        if S.alive then fn(...) end
    end)
    local list = bag or S.links
    list[#list + 1] = connection
    return connection
end
local function disconnect(bag)
    for _, connection in ipairs(bag) do connection:Disconnect() end
    table.clear(bag)
end
local function make(class, parent, properties)
    local object = Instance.new(class)
    for key, value in pairs(properties or {}) do object[key] = value end
    if object:IsA("GuiObject") then object.BorderSizePixel = 0; object.AutoLocalize = false end
    object.Parent = parent
    return object
end
local function corner(object, radius)
