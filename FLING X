-- Opacity is computed from immutable base values, so reversing a transition
-- cannot progressively darken the UI. Dynamic row/switch values refresh the base.
local function fadeRegister(root)
    local objects = root:GetDescendants()
    objects[#objects + 1] = root
    for _, object in ipairs(objects) do
        local props = {}
        if object:IsA("GuiObject") then
            props[#props + 1] = "BackgroundTransparency"
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then props[#props + 1] = "TextTransparency" end
            if object:IsA("ImageLabel") or object:IsA("ImageButton") then props[#props + 1] = "ImageTransparency" end
            if object:IsA("ScrollingFrame") then props[#props + 1] = "ScrollBarImageTransparency" end
        elseif object:IsA("UIStroke") then props[#props + 1] = "Transparency" end
        for _, property in ipairs(props) do
            S.fadeEntries[#S.fadeEntries + 1] = {object = object, property = property, base = object[property]}
        end
    end
end
local function applyFade()
    local value = UI.fade.Value
    for i = #S.fadeEntries, 1, -1 do
        local entry = S.fadeEntries[i]
        if entry.object.Parent then entry.object[entry.property] = 1 - (1 - entry.base) * value
        else table.remove(S.fadeEntries, i) end
    end
end
