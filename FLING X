local function drawFire(effect, time, opacity)
    local size = effect.host.AbsoluteSize
    if size.X < 2 or size.Y < 2 then return end
    local w = size.X / (effect.miniature and 1 or UI.scale.Scale)
    local h = size.Y / (effect.miniature and 1 or UI.scale.Scale)
    local small = effect.miniature
    for _, root in ipairs(effect.roots) do
        local side, seed, fraction = root.side, root.seed, root.fraction
        local horizontal = side == 1 or side == 3
        local x = horizontal and (7 + (w - 14) * fraction) or (side == 2 and w - 2 or 2)
        local y = horizontal and (side == 1 and (small and 9 or 13) or h + 6) or (12 + (h - 20) * fraction)
        local spacing = horizontal and w / root.count or h / root.count
        local width = small and 22 or (horizontal and math.clamp(spacing * 2.8, 38, 64) or 36)
        local turbulence = math.noise(seed, time * 2.1)
        local height = (small and 37 or (side == 1 and 65 or side == 3 and 46 or 55)) * root.height * (1 + turbulence * .22)
        local bend = math.noise(seed + 37, time * 1.8) * (small and 6 or 10)
        local age = (time * (.70 + seed % .21) + seed) % 1
        local heat = .44 + .40 * math.sin(age * math.pi) ^ 2
        -- The base does not lift off the edge; height, width and bend carry the
        -- upward motion. Independent phases remove the synchronized stamp look.
        root.body.Position = UDim2.fromOffset(x + bend * .55, y)
        root.body.Size = UDim2.fromOffset(width * (.90 + .12 * math.sin(time * 2.4 + seed)), height * (.85 + age * .28))
        root.body.Rotation = bend * .65
        root.body.ImageTransparency = 1 - heat * .78 * opacity
        root.core.Position = UDim2.fromOffset(x - bend * .25, y + 1)
        root.core.Size = UDim2.fromOffset(width * (.34 + .12 * math.sin(time * 1.8 + seed) ^ 2), height * (.59 + .21 * math.sin(time * 2 + seed) ^ 2))
        root.core.Rotation = -bend * .48
        root.core.ImageTransparency = 1 - (.30 + .24 * math.sin(time * 3.1 + seed) ^ 2) * opacity
    end
    for side, field in ipairs(effect.fields) do
        local horizontal = side == 1 or side == 3
        field.Size = horizontal and UDim2.fromOffset(w - 14, 24) or UDim2.fromOffset(24, h - 14)
        if side == 1 then field.Position = UDim2.fromOffset(7, -12)
        elseif side == 2 then field.Position = UDim2.fromOffset(w - 12, 7)
        elseif side == 3 then field.Position = UDim2.fromOffset(7, h - 12)
        else field.Position = UDim2.fromOffset(-12, 7) end
        field.BackgroundTransparency = 1 - (.24 + .05 * math.sin(time * 1.7 + side) ^ 2) * opacity
    end
    for _, ember in ipairs(effect.embers) do
        local seed = ember.seed
        local age = (time * (.35 + seed % .13) + seed) % 1
        local side = math.floor(seed) % 3
        local x = side == 0 and ((seed % 1) * w) or (side == 1 and -5 or w + 5)
        local y = side == 0 and 5 or (seed % 1) * h
        x = x + math.sin(seed + age * 4) * (small and 4 or 7) * age
        y = y - age * (small and 42 or 72)
        ember.node.Position = UDim2.fromOffset(x, y)
        ember.node.BackgroundTransparency = 1 - math.sin(age * math.pi) ^ 2 * .72 * opacity
    end
end

local function validFire(body)
    return type(body) == "string" and #body == FIRE.bytes and body:sub(1, 8) == "\137PNG\13\10\26\10"
        and body:sub(13, 16) == "IHDR" and body:sub(-8, -5) == "IEND"
end
local function loadFire()
    local custom = getcustomasset or getsynasset
    if type(custom) ~= "function" or type(writefile) ~= "function" then
        UI.gui:SetAttribute("FireTexture", "built-in fallback"); return
    end
    local cached = false
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, body = pcall(function() if isfile(FIRE.file) then return readfile(FIRE.file) end end)
        cached = ok and validFire(body)
    end
    if not cached then
        local ok, body = pcall(function() return game:HttpGet(FIRE.url) end)
        if not S.alive then return end
        if not ok or not validFire(body) then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
        if not pcall(writefile, FIRE.file, body) then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
    end
    local ok, uri = pcall(custom, FIRE.file)
    if not S.alive then return end
    if not ok or type(uri) ~= "string" or uri == "" then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
    for _, image in ipairs(FIRE.images) do
        image.Image = uri
        image.ImageRectOffset = Vector2.new(218, 30)
        image.ImageRectSize = Vector2.new(850, 1188)
    end
    pcall(function() ContentProvider:PreloadAsync({FIRE.images[1]}) end)
    if not S.alive then return end
    if FIRE.images[1].IsLoaded then
        FIRE.custom = true; UI.gui:SetAttribute("FireTexture", "Reyzn X original")
    else
        for _, image in ipairs(FIRE.images) do
            image.Image = FIRE.image; image.ImageRectOffset = Vector2.new(); image.ImageRectSize = Vector2.new()
        end
        UI.gui:SetAttribute("FireTexture", "built-in fallback")
    end
end

function UI.clampWindow()
    local available = UI.screen.AbsoluteSize
    local size = UI.window.Size
    local x = UI.window.Position.X.Offset
    local y = UI.window.Position.Y.Offset
    local minX, minY = size.X.Offset / 2 + 12, size.Y.Offset / 2 + 12
    UI.window.Position = UDim2.fromOffset(math.clamp(x, minX, math.max(minX, available.X - minX)),
        math.clamp(y, minY, math.max(minY, available.Y - minY)))
