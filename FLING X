local function drawFire(effect, time, opacity)
    local size = effect.host.AbsoluteSize
    if size.X < 2 or size.Y < 2 then return end
    local w, h = size.X / (effect.miniature and 1 or UI.scale.Scale), size.Y / (effect.miniature and 1 or UI.scale.Scale)
    local small = effect.miniature
    for _, root in ipairs(effect.roots) do
        local side, seed, fraction = root.side, root.seed, root.fraction
        local x = (side == 1 or side == 3) and (12 + (w - 24) * fraction) or (side == 2 and w - 1 or 1)
        local y = (side == 2 or side == 4) and (16 + (h - 32) * fraction) or (side == 1 and 4 or h - 17)
        local width = small and 20 or ((side == 1 or side == 3) and math.clamp(w / root.count * 1.35, 28, 72) or 32)
        local height = (small and 38 or (side == 1 and 62 or 53)) * (1 + math.noise(seed, time * 1.7) * .28)
        local bend = math.noise(seed + 19, time * 1.5) * (small and 6 or 13)
        local age = (time * (.62 + (seed % .18)) + seed) % 1
        local envelope = math.sin(age * math.pi) ^ 2
        local other = (age + .5) % 1
        root.veil.Position = UDim2.fromOffset(x + bend * 1.3, y - age * 8)
        root.veil.Size = UDim2.fromOffset(width * (1.2 - age * .3), height * (1 + age * .35))
        root.veil.Rotation = bend * .9
        root.veil.ImageTransparency = 1 - envelope * .44 * opacity
        root.body.Position = UDim2.fromOffset(x + bend, y - other * 5)
        root.body.Size = UDim2.fromOffset(width * (.85 - other * .17), height * (.82 + other * .37))
        root.body.Rotation = -bend * .7
        root.body.ImageTransparency = 1 - math.sin(other * math.pi) ^ 2 * .65 * opacity
        root.core.Position = UDim2.fromOffset(x + bend * .3, y)
        root.core.Size = UDim2.fromOffset(width * .43, height * .63)
        root.core.Rotation = bend * .25
        root.core.ImageTransparency = 1 - (.20 + .08 * math.sin(time * 3 + seed) ^ 2) * opacity
    end
    for _, ember in ipairs(effect.embers) do
        local age = (time * .32 + ember.seed) % 1
        local seed = ember.seed
        local x = (seed % 1) * w + math.sin(seed + age * 4) * 7
        local y = (math.floor(seed) % 2 == 0 and h - 18 or 0) - age * (small and 40 or 70)
        ember.node.Position = UDim2.fromOffset(x, y)
        ember.node.BackgroundTransparency = 1 - math.sin(age * math.pi) ^ 2 * .6 * opacity
    end
end

local function validFire(body)
    return type(body) == "string" and #body == FIRE.bytes and body:sub(1, 8) == "\137PNG\13\10\26\10"
        and body:sub(13, 16) == "IHDR" and body:sub(-8, -5) == "IEND"
end
local function loadFire()
    local custom = getcustomasset or getsynasset
    if type(custom) ~= "function" or type(writefile) ~= "function" then
        UI.gui:SetAttribute("FireTexture", "built-in fallback"); return
    end
    local cached = false
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, body = pcall(function() if isfile(FIRE.file) then return readfile(FIRE.file) end end)
        cached = ok and validFire(body)
    end
    if not cached then
        local ok, body = pcall(function() return game:HttpGet(FIRE.url) end)
        if not S.alive then return end
        if not ok or not validFire(body) then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
        if not pcall(writefile, FIRE.file, body) then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
    end
    local ok, uri = pcall(custom, FIRE.file)
    if not S.alive then return end
    if not ok or type(uri) ~= "string" or uri == "" then UI.gui:SetAttribute("FireTexture", "built-in fallback"); return end
    for _, image in ipairs(FIRE.images) do
        image.Image = uri
        image.ImageRectOffset = Vector2.new(110, 0)
        image.ImageRectSize = Vector2.new(1040, 1254)
    end
    pcall(function() ContentProvider:PreloadAsync({FIRE.images[1]}) end)
    if not S.alive then return end
    if FIRE.images[1].IsLoaded then
        FIRE.custom = true; UI.gui:SetAttribute("FireTexture", "Reyzn X original")
    else
        for _, image in ipairs(FIRE.images) do
            image.Image = FIRE.image; image.ImageRectOffset = Vector2.new(); image.ImageRectSize = Vector2.new()
        end
        UI.gui:SetAttribute("FireTexture", "built-in fallback")
    end
end

function UI.clampWindow()
    local available = UI.screen.AbsoluteSize
    local size = UI.window.Size
    local x = UI.window.Position.X.Offset
    local y = UI.window.Position.Y.Offset
    local minX, minY = size.X.Offset / 2 + 12, size.Y.Offset / 2 + 12
    UI.window.Position = UDim2.fromOffset(math.clamp(x, minX, math.max(minX, available.X - minX)),
        math.clamp(y, minY, math.max(minY, available.Y - minY)))
end
function UI.resize(initial)
    local available = UI.screen.AbsoluteSize
    if available.X < 100 or available.Y < 100 then return end
    local narrow = available.X < 600 and available.Y >= 440
    local width = math.min(710, available.X - 32)
    local height = math.min(narrow and 620 or 456, available.Y - 36)
    local dockWidth = narrow and width or 154
    local dockHeight = narrow and 106 or height - 28
    local panelY = narrow and 116 or 0
    local panelX = narrow and 0 or 164
    UI.window.Size = UDim2.fromOffset(width, height)
    UI.dock.Size = UDim2.fromOffset(dockWidth, dockHeight)
    UI.panel.Position = UDim2.fromOffset(panelX, panelY)
    UI.panel.Size = UDim2.fromOffset(width - panelX, height - 28 - panelY)
    UI.brand.Position = UDim2.fromOffset(17, 6)
    UI.brandX.Position = UDim2.fromOffset(111, 8)
    UI.dragDock.Size = narrow and UDim2.new(1, -112, 0, 55) or UDim2.new(1, 0, 0, 62)
    UI.dockDivider.Visible = not narrow
    for i, name in ipairs({"Targets", "Controls"}) do
        local nav = UI.nav[name].button
        nav.Position = narrow and UDim2.new((i - 1) * .5, i == 1 and 10 or 4, 0, 56)
            or UDim2.fromOffset(10, 77 + (i - 1) * 55)
        nav.Size = narrow and UDim2.new(.5, -14, 0, 40) or UDim2.new(1, -20, 0, 46)
    end
    UI.windowControls.Position = narrow and UDim2.new(1, -107, 0, 8) or UDim2.new(0, 10, 1, -54)
    UI.windowControls.Size = narrow and UDim2.fromOffset(97, 40) or UDim2.new(1, -20, 0, 44)
    if initial or not S.moved then UI.window.Position = UDim2.fromOffset(available.X / 2, available.Y / 2) end
    UI.clampWindow()
    UI.launcher.Position = UDim2.fromOffset(math.clamp(UI.launcher.Position.X.Offset, 8, math.max(8, available.X - 70)),
        math.clamp(UI.launcher.Position.Y.Offset, 8, math.max(8, available.Y - 70)))
    for _, record in pairs(UI.switches) do record.text.TextSize = width < 350 and 12 or 14 end
end
function UI.minimizeWindow(value)
    if S.closing then return end
    S.minimized = value
    S.fadeVersion = S.fadeVersion + 1
    local version = S.fadeVersion
    UI.launcher.Visible = value
    if not value then UI.window.Visible = true; UI.resize(false) end
    animate(UI.fade, .22, {Value = value and 0 or 1})
    animate(UI.scale, .26, {Scale = value and .96 or 1})
    task.delay(.27, function()
        if S.alive and version == S.fadeVersion then UI.window.Visible = not S.minimized end
    end)
    UI.gui:SetAttribute("Minimized", value)
end
local function draggable(handle, object, miniature)
    link(handle.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if S.drag then return end
        S.drag = {input = input, start = Vector2.new(input.Position.X, input.Position.Y), object = object,
            position = object.Position, miniature = miniature, moved = false}
    end)
end
draggable(UI.dragDock, UI.window, false)
draggable(UI.dragPanel, UI.window, false)
draggable(UI.launcher, UI.launcher, true)
link(Input.InputChanged, function(input)
    local drag = S.drag
    if not drag then return end
    if drag.input.UserInputType == Enum.UserInputType.Touch then
        if input ~= drag.input then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local delta = Vector2.new(input.Position.X, input.Position.Y) - drag.start
    if delta.Magnitude > 6 then drag.moved = true end
    if not drag.moved then return end
    if drag.miniature then
        local available = UI.screen.AbsoluteSize
        drag.object.Position = UDim2.fromOffset(math.clamp(drag.position.X.Offset + delta.X, 8, math.max(8, available.X - 70)),
            math.clamp(drag.position.Y.Offset + delta.Y, 8, math.max(8, available.Y - 70)))
    else
        S.moved = true
        drag.object.Position = UDim2.fromOffset(drag.position.X.Offset + delta.X, drag.position.Y.Offset + delta.Y)
        UI.clampWindow()
    end
end)
link(Input.InputEnded, function(input)
    local drag = S.drag
    if not drag then return end
    if input == drag.input or (drag.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
        if drag.miniature and drag.moved then S.ignoreLauncherUntil = os.clock() + .2 end
        S.drag = nil
    end
end)
link(Input.WindowFocusReleased, function() S.drag = nil; S.focused = false end)
link(Input.WindowFocused, function() S.focused = true end)
link(UI.minimize.Activated, function() UI.minimizeWindow(true) end)
link(UI.launcher.Activated, function()
    if (S.drag and S.drag.moved) or os.clock() < (S.ignoreLauncherUntil or 0) then return end
    UI.minimizeWindow(false)
end)
link(Input.InputBegan, function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightControl and not Input:GetFocusedTextBox() then
        UI.minimizeWindow(not S.minimized)
    end
end)
link(UI.screen:GetPropertyChangedSignal("AbsoluteSize"), function() UI.resize(false) end)

local function cleanup()
    if not S.alive then return end
    -- Stop physics synchronously before disconnecting anything; re-execution
    -- cannot leave the previous instance spinning or holding a camera subject.
    pcall(function() Engine.stop(nil, false, true) end)
    pcall(Engine.releasePhysics)
    pcall(Engine.restoreNoclip)
    pcall(Engine.clearGuards)
    S.alive = false
    disconnect(S.links)
    disconnect(S.characterLinks)
    for _, row in pairs(S.rows) do disconnect(row.links) end
    for _, tween in pairs(S.tweens) do tween:Cancel() end
    table.clear(S.tweens)
    S.drag = nil
    if S.assetThread and coroutine.status(S.assetThread) ~= "dead" then pcall(task.cancel, S.assetThread) end
end
S.links[#S.links + 1] = UI.gui.Destroying:Connect(cleanup)
link(UI.close.Activated, function()
    if S.closing then return end
    S.closing = true
    Engine.stop("Stopped", false, true)
    S.fadeVersion = S.fadeVersion + 1
    animate(UI.fade, .18, {Value = 0})
    animate(UI.scale, .18, {Scale = .96})
    task.delay(.2, function() if S.alive then UI.gui:Destroy() end end)
end)
link(LP.CharacterAdded, Engine.bind)
link(LP.CharacterRemoving, function(character) if S.character == character then Engine.bind(nil) end end)
