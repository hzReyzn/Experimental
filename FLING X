link(Input.InputChanged, function(input)
    local drag = S.drag
    if not drag then return end
    if drag.input.UserInputType == Enum.UserInputType.Touch then
        if input ~= drag.input then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local delta = Vector2.new(input.Position.X, input.Position.Y) - drag.start
    if delta.Magnitude > 6 then drag.moved = true end
    if not drag.moved then return end
    if drag.miniature then
        local available = UI.screen.AbsoluteSize
        drag.object.Position = UDim2.fromOffset(math.clamp(drag.position.X.Offset + delta.X, 8, math.max(8, available.X - 70)),
            math.clamp(drag.position.Y.Offset + delta.Y, 8, math.max(8, available.Y - 70)))
    else
        S.moved = true
