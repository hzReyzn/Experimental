-- RTX Cinematic Graphics (Cold / Day) by vxxfps, adapted as reversible
-- Lighting settings. We never execute the original external GUI/loader.
local Lighting=game:GetService("Lighting")
local props={"Ambient","OutdoorAmbient","Brightness","ClockTime"}
local saved=nil
local created={}
local active=false
local PROFILE={
    Ambient=Color3.fromRGB(120,135,160),
    OutdoorAmbient=Color3.fromRGB(150,170,195),
    Brightness=2,ClockTime=14,
    Tint=Color3.fromRGB(220,235,255),
    Saturation=.06,Contrast=.06,
    BloomIntensity=.35,BloomSize=10,BloomThreshold=.92,
    RayIntensity=.05,RaySpread=.9
}
local function restore()
    for _,obj in ipairs(created) do pcall(function()obj:Destroy()end) end
    table.clear(created)
    if saved then
        for _,key in ipairs(props) do
            local value=saved[key]
            if value~=nil then pcall(function()Lighting[key]=value end) end
        end
    end
    saved=nil
    active=false
    UI.gui:SetAttribute("ShadersEnabled",false)
end
local function activate()
    if active then return true end
    local snapshot={}
    for _,key in ipairs(props) do
        local ok,val=pcall(function()return Lighting[key]end)
        if not ok then return false end
        snapshot[key]=val
    end
    saved=snapshot
    local ok,err=pcall(function()
        for _,key in ipairs(props) do Lighting[key]=PROFILE[key] end
        local color=Instance.new("ColorCorrectionEffect")
        color.Name="ShadersX_ColdColor"
        color.TintColor=PROFILE.Tint
        color.Saturation=PROFILE.Saturation
        color.Contrast=PROFILE.Contrast
        color.Brightness=0
        color.Enabled=true
        color.Parent=Lighting
        created[#created+1]=color
        local bloom=Instance.new("BloomEffect")
        bloom.Name="ShadersX_CinematicBloom"
        bloom.Intensity=PROFILE.BloomIntensity
        bloom.Size=PROFILE.BloomSize
        bloom.Threshold=PROFILE.BloomThreshold
        bloom.Enabled=true
        bloom.Parent=Lighting
        created[#created+1]=bloom
        local rays=Instance.new("SunRaysEffect")
        rays.Name="ShadersX_CinematicSunRays"
        rays.Intensity=PROFILE.RayIntensity
        rays.Spread=PROFILE.RaySpread
        rays.Enabled=true
        rays.Parent=Lighting
        created[#created+1]=rays
    end)
    if not ok then
        restore()
        warn("Shaders X: shader could not start: "..tostring(err))
        return false
    end
    active=true
    UI.gui:SetAttribute("ShadersEnabled",true)
    state.burst=1
    return true
end
features.shader={enabled=false}
function features.shader:setEnabled(enabled)
    if enabled then self.enabled=activate()
    else restore();self.enabled=false end
    return self.enabled
end
function features.shader:destroy()
    self.enabled=false;restore()
end

