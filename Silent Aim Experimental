-- Touch- and mouse-friendly slider.
local sliderInput, sliderDragging
local function sliderSet(x)
    if track.AbsoluteSize.X < 1 then return end
    local fraction = math.clamp(
        (x - track.AbsolutePosition.X) / track.AbsoluteSize.X,
        0, 1
    )
    State.fov = math.floor(40 + fraction * 280 + .5)
    updateFov()
end
connect(track.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderInput, sliderDragging = input, true
        sliderSet(input.Position.X)
    end
end)
connect(UserInputService.InputChanged, function(input)
    if sliderDragging
        and (input == sliderInput
        or (sliderInput
            and sliderInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement)) then
        sliderSet(input.Position.X)
    end
end)
connect(UserInputService.InputEnded, function(input)
    if input == sliderInput then
        sliderInput, sliderDragging = nil, false
    end
end)

-- Draggable title + draggable minimized logo.
local dragTarget, dragInput, dragStart, startPosition, moved
local function startDrag(target, input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    dragTarget, dragInput = target, input
    dragStart, startPosition = input.Position, target.Position
    moved = false
end
connect(header.InputBegan, function(input)
    startDrag(main, input)
end)
connect(launcher.InputBegan, function(input)
    startDrag(launcher, input)
end)
connect(UserInputService.InputChanged, function(input)
    if not dragTarget then return end
    if input ~= dragInput
        and not (dragInput
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement) then
        return
    end
    local delta = input.Position - dragStart
    if delta.Magnitude > 8 then moved = true end
    dragTarget.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end)
connect(UserInputService.InputEnded, function(input)
    if input == dragInput
        or (dragInput
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragTarget, dragInput = nil, nil
    end
end)

