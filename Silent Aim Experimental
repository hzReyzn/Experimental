local function create(class, parent, props)
    local item = Instance.new(class)
    for key, value in pairs(props or {}) do
        item[key] = value
    end
    if item:IsA("GuiObject") then
        item.BorderSizePixel = 0
    end
    item.Parent = parent
    return item
end

local function corner(parent, size)
    return create("UICorner", parent, {
        CornerRadius = UDim.new(0, size or 10)
    })
end

local function stroke(parent, color, width, opacity)
    return create("UIStroke", parent, {
        Color = color or Colors.violet,
        Thickness = width or 1,
        Transparency = opacity or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })
end

local function gradient(parent, colors, rotation)
    local keys = {}
    for i, color in ipairs(colors) do
        keys[i] = ColorSequenceKeypoint.new(
            (i - 1) / (#colors - 1),
            color
        )
    end
    return create("UIGradient", parent, {
        Color = ColorSequence.new(keys),
        Rotation = rotation or 0
    })
end

