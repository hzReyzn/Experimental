function State:Destroy()
    if not self.alive then return end
    self.enabled = false
    self.alive = false
    for _, connection in ipairs(self.connections) do
        connection:Disconnect()
    end
    table.clear(self.connections)
    if self.gui then self.gui:Destroy() end
    if ENV[SESSION_KEY] == self then ENV[SESSION_KEY] = nil end
end
connect(close.MouseButton1Click, function()
    State:Destroy()
end)

local updateTime = 0
connect(RunService.Heartbeat, function(dt)
    updateTime += dt
    if updateTime < .09 then return end
    updateTime = 0

    local camera = Workspace.CurrentCamera
    if camera then
        panelScale.Scale = math.min(
            1,
            (camera.ViewportSize.X - 20) / 344,
            (camera.ViewportSize.Y - 30) / 442
        )
    end

    updateRing()
    mainGradient.Offset = Vector2.new(math.sin(os.clock() * .5) * .28, 0)
    logoGradient.Offset = Vector2.new(math.sin(os.clock() * .7) * .35, 0)
    accentGradient.Offset = Vector2.new(math.sin(os.clock() * .8) * .22, 0)

    local info = inspectSession()
    diagRound.Text = "GAME: " .. tostring(info.game or "UNKNOWN")
        .. "  |  TEAM: " .. tostring(info.team or "UNKNOWN")
    diagWeapon.Text = "TOOL: " .. tostring(info.tool)
        .. "  |  PLAYERS: " .. tostring(info.onlinePlayers)
    diagCounts.Text = string.format(
        "SCAN: %d  |  FOV: %d  |  LOS: %d",
        info.candidates, info.withinFov, info.visible
    )

    targetMarker.Visible = false
    if not State.enabled then return end

    local camera = Workspace.CurrentCamera
    if info.selectedPart and info.selectedPart.Parent and camera then
        statusText.Text = "VISIBLE PLAYER: "
            .. tostring(info.selectedName or info.selectedPart.Parent.Name)
        statusText.TextColor3 = Colors.green
        local point, onScreen =
            camera:WorldToViewportPoint(info.selectedPart.Position)
        if onScreen and point.Z > 0 then
            targetMarker.Position = UDim2.fromOffset(point.X, point.Y)
            targetMarker.Visible = true
        end
    elseif info.onlinePlayers == 0 then
        statusText.Text = "NO OTHER PLAYERS IN SERVER"
        statusText.TextColor3 = Colors.muted
    elseif info.aliveCharacters == 0 then
        statusText.Text = "NO LOADED / ALIVE CHARACTERS"
        statusText.TextColor3 = Colors.muted
    elseif info.candidates == 0 then
        statusText.Text = "ALL PLAYERS FILTERED BY GAME / TEAM"
        statusText.TextColor3 = Colors.muted
    elseif info.onscreen == 0 then
        statusText.Text = "NO CANDIDATES ON SCREEN"
        statusText.TextColor3 = Colors.muted
    elseif info.withinFov == 0 then
        statusText.Text = "CENTER VIEW OR INCREASE FOV"
        statusText.TextColor3 = Colors.muted
    elseif info.visible == 0 then
        statusText.Text = "BLOCKED BY WALL CHECK / OBSTACLES"
        statusText.TextColor3 = Colors.muted
