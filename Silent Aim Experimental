local function getDuelId(player)
    local id = player:GetAttribute("Game")
    if id == nil or tostring(id) == "" then return nil end
    return id
end

local function equippedDuelWeapon()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool then return false end
    -- These two objects occur in public DUELS implementations.
    return tool:FindFirstChild("fire") ~= nil
        and tool:FindFirstChild("showBeam") ~= nil
end

local function isVisible(part)
    if not State.wallCheck then return true end
    local camera = Workspace.CurrentCamera
    if not camera then return false end
    local origin = camera.CFrame.Position
    local difference = part.Position - origin
    if difference.Magnitude < 0.01 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        LocalPlayer.Character
    }
    params.IgnoreWater = true

    local hit = Workspace:Raycast(origin, difference, params)
    return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
end

function State:GetTarget(requireWeapon)
    if not self.alive or not self.enabled then return nil end
    if requireWeapon and not equippedDuelWeapon() then return nil end

    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local myGame = getDuelId(LocalPlayer)
    local myTeam = LocalPlayer:GetAttribute("Team")
    if not myGame or myTeam == nil then return nil end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local center = Vector2.new(
        camera.ViewportSize.X * 0.5,
        camera.ViewportSize.Y * 0.5
    )
    local nearest, nearestPixels = nil, self.fov

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer
            and getDuelId(other) == myGame
            and other:GetAttribute("Team") ~= nil
            and other:GetAttribute("Team") ~= myTeam then

            local char = other.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local part = char and (
                char:FindFirstChild(self.targetPart)
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("HumanoidRootPart")
            )

            if hum and hum.Health > 0 and part then
                local worldDistance = (part.Position - myRoot.Position).Magnitude
                if worldDistance <= self.maxDistance then
                    local point, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen and point.Z > 0 then
                        local pixels = (
                            Vector2.new(point.X, point.Y) - center
                        ).Magnitude

                        if pixels < nearestPixels and isVisible(part) then
                            nearest = part
                            nearestPixels = pixels
                        end
                    end
                end
            end
        end
    end
    return nearest
end

-- A single persistent hook, shared by re-executions.
-- Clicking OFF, closing the GUI, or replacing this script disables its effect.
local Hook = ENV[HOOK_KEY]
if type(Hook) ~= "table" then
    Hook = {
        installed = false,
        owner = nil,
        mouse = LocalPlayer:GetMouse()
    }
    ENV[HOOK_KEY] = Hook
end
Hook.owner = State

if not Hook.installed and type(hookmetamethod) == "function" then
    local oldIndex
    local function intercept(object, key)
        local current = Hook.owner
        if current
            and current.alive
            and current.enabled
            and object == Hook.mouse
            and (key == "Hit" or key == "Target") then

            local callerIsExecutor = false
            if type(checkcaller) == "function" then
                local ok, value = pcall(checkcaller)
                callerIsExecutor = ok and value == true
            end

            if not callerIsExecutor then
                local ok, target = pcall(
                    current.GetTarget, current, true
                )
                if ok and target then
                    if key == "Target" then
                        return target
                    end
                    return CFrame.new(target.Position)
                end
            end
        end
        return oldIndex(object, key)
    end

    local wrapped = intercept
    if type(newcclosure) == "function" then
        wrapped = newcclosure(intercept)
    end

    local ok, original = pcall(function()
        return hookmetamethod(game, "__index", wrapped)
    end)
    if ok and type(original) == "function" then
        oldIndex = original
        Hook.installed = true
    else
        warn("[Reyzn Silent Aim] Could not install Mouse hook")
    end
end
State.hookReady = Hook.installed

