function State:Destroy()
    if not self.alive then return end
    self.enabled = false
    self.alive = false
    if Hook.owner == self then Hook.owner = nil end
    for _, connection in ipairs(self.connections) do
        connection:Disconnect()
    end
    table.clear(self.connections)
    if self.gui then self.gui:Destroy() end
    if ENV[SESSION_KEY] == self then ENV[SESSION_KEY] = nil end
end
connect(close.MouseButton1Click, function()
    State:Destroy()
end)

local updateTime = 0
connect(RunService.Heartbeat, function(dt)
    updateTime += dt
    if updateTime < .09 then return end
    updateTime = 0

    local camera = Workspace.CurrentCamera
    if camera then
        panelScale.Scale = math.min(
            1,
            (camera.ViewportSize.X - 20) / 344,
            (camera.ViewportSize.Y - 30) / 368
        )
    end

    updateRing()
    mainGradient.Offset = Vector2.new(math.sin(os.clock() * .5) * .28, 0)
    logoGradient.Offset = Vector2.new(math.sin(os.clock() * .7) * .35, 0)
    accentGradient.Offset = Vector2.new(math.sin(os.clock() * .8) * .22, 0)

    if not State.enabled or not State.hookReady then return end
    if not getDuelId(LocalPlayer)
        or LocalPlayer:GetAttribute("Team") == nil then
        statusText.Text = "WAITING FOR AN ACTIVE DUEL"
        statusText.TextColor3 = Colors.muted
        return
    end
    if not equippedDuelWeapon() then
        statusText.Text = "EQUIP YOUR DUELS RANGED TOOL"
        statusText.TextColor3 = Colors.muted
        return
    end

    local target = State:GetTarget(false)
    if target and target.Parent then
        statusText.Text = "TARGET: " .. target.Parent.Name
        statusText.TextColor3 = Colors.green
    else
        statusText.Text = "NO TARGET INSIDE FOV"
        statusText.TextColor3 = Colors.muted
    end
end)

