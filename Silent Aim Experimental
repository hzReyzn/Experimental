-- Read-only diagnostics: never alter mouse properties, shots or tools.
-- Some DUELS modes do not replicate the Game/Team attributes. The preview
-- can still inspect visible player characters when those are absent.
local function getDuelId(player)
    local id = player:GetAttribute("Game")
    if id == nil or tostring(id) == "" then return nil end
    return id
end

local function getTeam(player)
    local team = player:GetAttribute("Team")
    if team ~= nil and tostring(team) ~= "" then return tostring(team) end
    if player.Team then return player.Team.Name end
    return nil
end

local function isEligibleForPreview(other)
    local gameA, gameB = getDuelId(LocalPlayer), getDuelId(other)
    if gameA and gameB and gameA ~= gameB then return false end

    local teamA, teamB = getTeam(LocalPlayer), getTeam(other)
    if teamA and teamB and teamA == teamB then return false end

    return true
end

local function getPreviewPart(model)
    return model and (
        model:FindFirstChild(State.targetPart)
        or model:FindFirstChild("Head")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
    )
end

local function isVisible(part)
    if not State.wallCheck then return true end
    local camera = Workspace.CurrentCamera
    if not camera then return false end

    local origin = camera.CFrame.Position
    local difference = part.Position - origin
    if difference.Magnitude < 0.01 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        params.FilterDescendantsInstances = {LocalPlayer.Character}
    end
    params.IgnoreWater = true

    local hit = Workspace:Raycast(origin, difference, params)
    return hit == nil or (
        part.Parent ~= nil
        and hit.Instance:IsDescendantOf(part.Parent)
    )
end

local function previewScan()
    local info = {
        game = getDuelId(LocalPlayer),
        team = getTeam(LocalPlayer),
        onlinePlayers = math.max(0, #Players:GetPlayers() - 1),
        aliveCharacters = 0,
        candidates = 0,
        onscreen = 0,
        withinFov = 0,
        visible = 0,
        filtered = 0,
        tool = "-",
        selectedPart = nil,
        selectedName = nil
    }

    local myChar = LocalPlayer.Character
    local tool = myChar and myChar:FindFirstChildOfClass("Tool")
    if tool then info.tool = tool.Name end

    local camera = Workspace.CurrentCamera
    if not camera then return info end

    local center = Vector2.new(
        camera.ViewportSize.X * .5,
        camera.ViewportSize.Y * .5
    )
    local nearestPixels = State.fov

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer then
            local model = other.Character
            local hum = model and model:FindFirstChildOfClass("Humanoid")
            local part = getPreviewPart(model)

            if hum and hum.Health > 0 and part then
                info.aliveCharacters += 1
                if isEligibleForPreview(other) then
                    info.candidates += 1
                    local point, onScreen =
                        camera:WorldToViewportPoint(part.Position)
                    if onScreen and point.Z > 0 then
                        info.onscreen += 1
                        local pixels = (
                            Vector2.new(point.X, point.Y) - center
                        ).Magnitude
                        if pixels <= State.fov then
                            info.withinFov += 1
                            if isVisible(part) then
                                info.visible += 1
                                if pixels < nearestPixels then
                                    nearestPixels = pixels
                                    info.selectedPart = part
                                    info.selectedName = other.DisplayName
                                end
                            end
                        end
                    end
                else
                    info.filtered += 1
                end
            end
        end
    end

    return info
end

-- Only a preview of player characters. Does not claim enemy identity when
-- the game's team or duel data is not available.
function State:GetTarget()
    if not self.alive or not self.enabled then return nil end
    return previewScan().selectedPart
end

local function inspectSession()
    return previewScan()
end

